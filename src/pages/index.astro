---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GulfCoastMesh Mobile</title>
    <meta
      name="description"
      content="GulfCoastMesh Mobile builds custom MeshCore firmware and browser-based tools for the mesh along the Gulf Coast."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="wrap">
      <header class="page-header">
        <span class="badge-pill">
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M13 2 3 14h7l-1 8 10-12h-7l1-8Z" />
          </svg>
          MOBMESH
        </span>
        <h1>GulfCoastMesh Mobile</h1>
        <p class="subtitle">Fewer trips and no climbing.</p>
      </header>

      <p class="lede">
        We build custom MeshCore firmware and browser-based tools for the mesh along the
        Gulf Coast. There is more to put here, but the tools work today.
      </p>

      <a class="panel" href="https://tools.mobmesh.org/">
        <svg
          class="panel-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M13 2 3 14h7l-1 8 10-12h-7l1-8Z" />
        </svg>
        <span>
          <strong>Firmware and tools</strong>
          <small>Flash a board, configure a repeater, read the map</small>
        </span>
        <svg
          class="panel-arrow"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>

      <footer class="page-footer">
        <p>
          Not affiliated with the official MeshCore project. Source and documentation at
          <a href="https://github.com/mobmesh/firmware" target="_blank" rel="noopener"
            >mobmesh/firmware</a
          >.
        </p>
      </footer>
    </div>
  </body>
</html>
